# ============================================================================
# 一加 Ace 6 (ktm) · ColorOS 16 · 6.6 内核 · SukiSU Ultra AK3 构建配置
# 适用于: xiaoleGun/KernelSU_Action (GitHub Actions)
# 组合:    sukisu-ultra(main) + SUSFS + KPM
# ============================================================================
CONFIG_ENV=config.env

# ------------------------------ 内核源码 ------------------------------
# OnePlus 官方开源内核仓库, Ace 6 专属 Android 16 分支
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8750
KERNEL_SOURCE_BRANCH=oneplus/sm8750_b_16.0.0_ace_6
# GKI 2.0 defconfig (Android 16 强制 GKI, 刷 boot 的 kernel 部分)
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# 产物命名标签 (影响 zip 文件名)
KERNEL_NAME=OnePlusAce6_Android16
ADD_LOCALVERSION_TO_FILENAME=false

# ------------------------------ 工具链 ------------------------------
# AOSP Clang, 6.6 内核用 2026 版已验证组合
CLANG_BRANCH=main-kernel-2026
CLANG_VERSION=r584948c
USE_CUSTOM_CLANG=false

# 全 LLVM 构建 (6.6 GKI 树要求)
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

# ------------------------------ SukiSU Ultra ------------------------------
# main = v4 模块化树, 支持 KPM
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
# 6.6 内核 kprobes 可靠, 用 auto
KSU_HOOK_MODE=auto

# ------------------------------ SUSFS ------------------------------
# 6.6 内核自动映射 gki-android15-6.6 分支
ENABLE_SUSFS=true
SUSFS_BRANCH=auto

# ------------------------------ KPM ------------------------------
# Kernel Patch Module 支持 (编译后对 Image 执行 patch_linux)
ENABLE_KPM=true

# ------------------------------ 附加补丁 ------------------------------
ENABLE_PATH_UMOUNT=true   # 6.6 已自带 path_umount, 会自动跳过
ENABLE_HIDE_STUFF=false   # 需要更强隐藏痕迹时改 true
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true

# ------------------------------ Kconfig ------------------------------
DISABLE_LTO=false
DISABLE_CC_WERROR=true    # 防止告警被当错误导致首次构建失败
EXTRA_DEFCONFIG=

# ------------------------------ AnyKernel3 ------------------------------
USE_CUSTOM_ANYKERNEL3=false

# ------------------------------ 打包 ------------------------------
NEED_DTBO=false
# boot.img 重打包关闭: AK3 直接刷 Image 到 boot 分区
BUILD_BOOT_IMG=false

# ------------------------------ 构建环境 ------------------------------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
